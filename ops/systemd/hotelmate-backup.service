[Unit]
Description=HotelMate verified encrypted recovery-set backup
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=hotelmate
Group=hotelmate
WorkingDirectory=/srv/hotelmate
ExecStart=/usr/local/bin/hotelmate --config /etc/hotelmate/production.env backup create --yes
Environment=DOCKER_CONFIG=/run/hotelmate-backup-docker
RuntimeDirectory=hotelmate-backup-docker
RuntimeDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/hotelmate-private /var/lib/node_exporter/textfile_collector
UMask=0077
TimeoutStartSec=2h
