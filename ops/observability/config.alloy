discovery.docker "hotelmate" {
  host             = "unix:///var/run/docker.sock"
  refresh_interval = "5s"
}

discovery.relabel "hotelmate" {
  targets = discovery.docker.hotelmate.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.+)"
    target_label  = "container"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }
}

loki.source.docker "hotelmate" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.hotelmate.output
  labels     = { environment = sys.env("HOTELMATE_ENVIRONMENT") }
  forward_to = [loki.process.hotelmate.receiver]
}

loki.process "hotelmate" {
  forward_to = [loki.write.local.receiver]

  stage.json {
    expressions = {
      request_id = "requestId",
      level      = "level",
      status     = "status",
    }
  }

  // Request IDs remain searchable structured metadata instead of
  // high-cardinality stream labels.
  stage.structured_metadata {
    values = {
      request_id = "",
    }
  }
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
