# Application
APP_ENV=development
API_HTTP_ADDR=:8080
API_PORT=8080
WEB_PORT=3000
API_VERSION=1.0.0
ENABLE_HSTS=false
JWT_SECRET=replace-this-development-secret-now
JWT_ISSUER=hotelmate-api
STAFF_TOKEN_TTL=8h
GUEST_TOKEN_TTL=24h
ONBOARDING_TOKEN=replace-this-onboarding-token
UPLOADS_DIR=uploads
DOCUMENT_MAX_BYTES=5242880
DOCUMENT_RETENTION=720h
CHAT_RETENTION=2160h
CHAT_CONFIDENCE_THRESHOLD=0.5
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
AUTO_MIGRATE=true

# PostgreSQL
POSTGRES_DB=hotelmate
POSTGRES_USER=hotelmate
POSTGRES_PASSWORD=hotelmate
POSTGRES_PORT=5432
DATABASE_URL=postgres://hotelmate:hotelmate@127.0.0.1:5432/hotelmate?sslmode=disable
HOTELMATE_POSTGRES_DRIVER=compose

# Frontend
VITE_API_BASE_URL=
