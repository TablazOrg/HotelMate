# Application
APP_ENV=development
API_HTTP_ADDR=:8080
API_PORT=8080
WEB_PORT=3000
API_VERSION=0.3.0
JWT_SECRET=replace-this-development-secret-now
JWT_ISSUER=hotelmate-api
STAFF_TOKEN_TTL=8h
GUEST_TOKEN_TTL=24h
ONBOARDING_TOKEN=replace-this-onboarding-token
UPLOADS_DIR=uploads
DOCUMENT_MAX_BYTES=5242880
DOCUMENT_RETENTION=720h
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
AUTO_MIGRATE=true

# PostgreSQL
POSTGRES_DB=hotelmate
POSTGRES_USER=hotelmate
POSTGRES_PASSWORD=hotelmate
POSTGRES_PORT=5432
DATABASE_URL=postgres://hotelmate:hotelmate@localhost:5432/hotelmate?sslmode=disable

# Frontend
VITE_API_BASE_URL=
