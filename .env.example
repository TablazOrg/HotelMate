# Application
APP_ENV=development
API_HTTP_ADDR=:8080
API_PORT=8080
API_VERSION=0.1.0
JWT_SECRET=replace-this-development-secret
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
AUTO_MIGRATE=true

# PostgreSQL
POSTGRES_DB=hotelmate
POSTGRES_USER=hotelmate
POSTGRES_PASSWORD=hotelmate
POSTGRES_PORT=5432
DATABASE_URL=postgres://hotelmate:hotelmate@localhost:5432/hotelmate?sslmode=disable

# Frontend
VITE_API_BASE_URL=http://localhost:8080
