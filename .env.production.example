APP_ENV=production
API_VERSION=1.0.0
ENABLE_HSTS=true
DOMAIN=hotel.example.com

POSTGRES_DB=hotelmate
POSTGRES_USER=hotelmate
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
POSTGRES_PORT=5432
DATABASE_URL=postgres://hotelmate:replace-with-a-long-random-database-password@127.0.0.1:5432/hotelmate?sslmode=disable

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=hotelmate-api
STAFF_TOKEN_TTL=8h
GUEST_TOKEN_TTL=24h
ONBOARDING_TOKEN=replace-with-a-separate-long-random-token
UPLOADS_DIR=/app/uploads
DOCUMENT_MAX_BYTES=5242880
DOCUMENT_RETENTION=720h
CHAT_RETENTION=2160h
CHAT_CONFIDENCE_THRESHOLD=0.5
ALLOWED_ORIGINS=https://hotel.example.com

# M7 operations (release image values are managed from the signed release manifest)
HOTELMATE_BASE_URL=https://hotel.example.com
HOTELMATE_COMPOSE_FILE=/srv/hotelmate/docker-compose.production.yml
HOTELMATE_ENV_FILE=/srv/hotelmate/.env.production
HOTELMATE_BACKUP_DIR=/srv/hotelmate-private/backups
HOTELMATE_EVIDENCE_DIR=/srv/hotelmate-private/evidence
HOTELMATE_HOST_UPLOADS_DIR=/srv/hotelmate-private/uploads
HOTELMATE_MIN_DISK_BYTES=5368709120
HOTELMATE_TEXTFILE_DIR=/var/lib/node_exporter/textfile_collector
HOTELMATE_POSTGRES_DRIVER=direct
RESTIC_REPOSITORY=s3:s3.example.com/hotelmate-production
RESTIC_PASSWORD=replace-with-a-separate-restic-repository-password
RESTIC_KEEP_DAILY=14
RESTIC_KEEP_WEEKLY=8
COSIGN_CERTIFICATE_IDENTITY=https://github.com/TablazOrg/HotelMate/.github/workflows/release.yml@refs/heads/main
COSIGN_CERTIFICATE_OIDC_ISSUER=https://token.actions.githubusercontent.com
SMOKE_HOTEL_SLUG=replace-with-dedicated-smoke-hotel
SMOKE_STAFF_EMAIL=replace-with-dedicated-smoke-account@example.com
SMOKE_STAFF_PASSWORD=replace-with-dedicated-smoke-password

# A dedicated non-production config may enable the automated drill command.
HOTELMATE_ISOLATED_RECOVERY_DRILL=false
# HOTELMATE_RECOVERY_POINT=2026-08-22T20:00:00Z
# HOTELMATE_OPERATOR=operator@example.com
# HOTELMATE_DRILL_MAX_RPO=24h
# HOTELMATE_DRILL_MAX_RTO=2h
