APP_ENV=production
API_VERSION=0.4.0
DOMAIN=hotel.example.com

POSTGRES_DB=hotelmate
POSTGRES_USER=hotelmate
POSTGRES_PASSWORD=replace-with-a-long-random-database-password

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=hotelmate-api
STAFF_TOKEN_TTL=8h
GUEST_TOKEN_TTL=24h
ONBOARDING_TOKEN=replace-with-a-separate-long-random-token
UPLOADS_DIR=/app/uploads
DOCUMENT_MAX_BYTES=5242880
DOCUMENT_RETENTION=720h
ALLOWED_ORIGINS=https://hotel.example.com
